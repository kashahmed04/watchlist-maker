<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title>Documentation</title>
  <link rel="shortcut icon" href="/assets/img/popcorn.png"/>
  <link rel="stylesheet" type="text/css" href="/assets/documentation.css"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Itim&display=swap" rel="stylesheet">
</head>
<body>
  <nav><a href="/login"><img id="logo" src="/assets/img/popcorn.png" alt="popcorn"/></a>
    <div class="navlink"><a href="/maker">Back</a></div>
  </nav>

  <!--we do not need the error message content in documentation and error page right**-->
 

  <h1>Watchlist Maker Documentation</h1>
  <section id="top">

    <div class="routes">
        <h2>URL:</h2> <h3>/getList</h3>
        <h2>Supported Methods:</h2> <h3>GET, HEAD</h3>
        <h2>Middleware:</h2> <h3>Requires Login</h3>
        <!--is this ok do we only put information here if the user has to put in information
        for POST requests not for GET or HEAD requests right****-->
        <h2>Query Params:</h2> <h3>None</h3>
        <h2>Description:</h2> <h3>Retrieves watchlist information to load the users watchlist</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

     <div class="routes"></div>
        <h2>URL:</h2> <h3>/login</h3>
        <h2>Supported Methods:</h2> <h3>GET, HEAD</h3>
        <h2>Middleware:</h2> <h3>Requires Secure, Requires Logout</h3>
        <h2>Query Params:</h2> <h3>None</h3>
        <!--go over****-->
        <h2>Description:</h2> <h3>Retrieves the login page for the user</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

     <div class="routes"></div>
        <h2>URL:</h2> <h3>/login</h3>
        <!--should we specify more for the pathname or is this ok if we have
        two of the same pathnames****-->
        <h2>Supported Methods:</h2> <h3>POST</h3>
        <h2>Middleware:</h2> <h3>Requires Secure, Requires Logout</h3>
        <!--this is what the user is supposed to type in right****-->
        <h2>Query Params:</h2> <h3>Username and Password</h3>
        <h2>Description:</h2> <h3>Logs an existing user in after giving both a username and password</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

     <div class="routes"></div>
        <h2>URL:</h2> <h3>/signup</h3>
        <h2>Supported Methods:</h2> <h3>POST</h3>
        <h2>Middleware:</h2> <h3>Requires Secure, Requires Logout</h3>
        <h2>Query Params:</h2> <h3>Username, Password, Retype Password</h3>
        <h2>Description:</h2> <h3>Allows a user to make an account if they put in a 
            username, password, and retype their password
        </h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

    
     <div class="routes"></div>
        <h2>URL:</h2> <h3>/logout</h3>
        <h2>Supported Methods:</h2> <h3>GET, HEAD</h3>
        <h2>Middleware:</h2> <h3>Requires Login</h3>
        <h2>Query Params:</h2> <h3>None</h3>
        <h2>Description:</h2> <h3>Logs out a user and brings them back to the login page</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

     <div class="routes"></div>
        <h2>URL:</h2> <h3>/logout</h3>
        <h2>Supported Methods:</h2> <h3>GET, HEAD</h3>
        <h2>Middleware:</h2> <h3>Requires Login</h3>
        <h2>Query Params:</h2> <h3>None</h3>
        <h2>Description:</h2> <h3>Logs out a user and brings them back to the login page</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

     <div class="routes"></div>
        <h2>URL:</h2> <h3>/maker</h3>
        <h2>Supported Methods:</h2> <h3>GET, HEAD</h3>
        <h2>Middleware:</h2> <h3>Requires Login</h3>
        <h2>Query Params:</h2> <h3>None</h3>
        <h2>Description:</h2> <h3>Gets the maker page for the user when they login</h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

       <div class="routes"></div>
        <h2>URL:</h2> <h3>/maker</h3>
        <h2>Supported Methods:</h2> <h3>POST</h3>
        <h2>Middleware:</h2> <h3>Requires Login</h3>
        <h2>Query Params:</h2> <h3>Title and Status</h3>
        <h2>Description:</h2> <h3>Required the user to type in both a title and a status to put within
            the watchlist. When a user is not subscribed, they are not allowed
            to add more than 5 items. If they are subscribed they can add any number of items.
        </h3>
        <h2>Return Type(s):</h2> <h3>JSON</h3>
    </div>

  </section>

</body>
</html>



